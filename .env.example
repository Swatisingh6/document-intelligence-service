APP_NAME="Document Intelligence & Question Extraction Service"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1

SECRET_KEY=change-me-super-secret-key-for-jwt-signing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/doc_intel
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=20

TESSERACT_CMD=tesseract

# Optional External AI/LLM Provider (Default 'none' for local deterministic extraction)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

HIGH_CONFIDENCE_THRESHOLD=0.85
MEDIUM_CONFIDENCE_THRESHOLD=0.60
