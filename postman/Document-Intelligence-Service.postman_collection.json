{
	"info": {
		"_postman_id": "8f3b2c1d-4e5f-6a7b-8c9d-0e1f2a3b4c5d",
		"name": "Document Intelligence Service",
		"description": "Postman Collection for Document Intelligence & Question Extraction Service API endpoints.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api/v1",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "document_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "question_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "answer_key_document_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "1. Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"candidate@example.com\",\n  \"password\": \"securepassword123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/register",
							"host": ["{{base_url}}"],
							"path": ["auth", "register"]
						}
					}
				},
				{
					"name": "2. Login & Obtain JWT Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.access_token) {",
									"    pm.collectionVariables.set('token', jsonData.access_token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"candidate@example.com\",\n  \"password\": \"securepassword123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						}
					}
				}
			]
		},
		{
			"name": "Documents & Extraction",
			"item": [
				{
					"name": "3. Upload Clean Digital PDF",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.document_id) {",
									"    pm.collectionVariables.set('document_id', jsonData.document_id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": "samples/clean_digital.pdf"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/documents/upload",
							"host": ["{{base_url}}"],
							"path": ["documents", "upload"]
						}
					}
				},
				{
					"name": "4. Upload Image Question Paper",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": "samples/scanned_exam.png"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/documents/upload",
							"host": ["{{base_url}}"],
							"path": ["documents", "upload"]
						}
					}
				},
				{
					"name": "5. Check Document Status",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/documents/{{document_id}}/status",
							"host": ["{{base_url}}"],
							"path": ["documents", "{{document_id}}", "status"]
						}
					}
				},
				{
					"name": "6. List Questions (Filtered & Paginated)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.items && jsonData.items.length > 0) {",
									"    pm.collectionVariables.set('question_id', jsonData.items[0].id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/documents/{{document_id}}/questions?page=1&page_size=20",
							"host": ["{{base_url}}"],
							"path": ["documents", "{{document_id}}", "questions"],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "page_size",
									"value": "20"
								}
							]
						}
					}
				},
				{
					"name": "7. Get Single Question Details",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/questions/{{question_id}}",
							"host": ["{{base_url}}"],
							"path": ["questions", "{{question_id}}"]
						}
					}
				},
				{
					"name": "8. Get Document Answers",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/documents/{{document_id}}/answers",
							"host": ["{{base_url}}"],
							"path": ["documents", "{{document_id}}", "answers"]
						}
					}
				},
				{
					"name": "9. Get Extraction Warnings",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/documents/{{document_id}}/warnings",
							"host": ["{{base_url}}"],
							"path": ["documents", "{{document_id}}", "warnings"]
						}
					}
				}
			]
		},
		{
			"name": "Relationships",
			"item": [
				{
