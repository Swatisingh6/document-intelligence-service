								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"related_document_id\": \"{{answer_key_document_id}}\",\n  \"relationship_type\": \"answer_key\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/documents/{{document_id}}/relationships",
							"host": ["{{base_url}}"],
							"path": ["documents", "{{document_id}}", "relationships"]
						}
					}
				},
				{
					"name": "12. Retrieve Relationships",
					"request": {
						"auth": {
							"type": "bearer",
